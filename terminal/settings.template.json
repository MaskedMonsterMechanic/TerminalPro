{
  "$schema": "https://aka.ms/terminal-profiles-schema",
  "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
  "copyOnSelect": false,
  "copyFormatting": false,

  "profiles": {
    "defaults": {
      "colorScheme": "One",
      "font": { "face": "Cascadia Code", "size": 10 },
      "useAcrylic": true,
      "backgroundImageAlignment": "bottomRight",
      "backgroundImageOpacity": 0.1,
      "backgroundImageStretchMode": "none"
    },
    "list": [
      {
        "name": "PowerShell",
        "guid": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
        "commandline": "\"{{HOME}}\\pwsh\\pwsh.exe\" -NoLogo -NoProfile -NoExit -Command \". \\\"{{HOME}}\\profile\\profile.ps1\\\"\"",
        "opacity": 10,
        "backgroundImage": "{{HOME}}\\images\\toxicrick.png"
      },
      {
        "name": "Windows PowerShell",
        "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
        "commandline": "powershell.exe -NoLogo -NoProfile -NoExit -Command \". \\\"{{HOME}}\\profile\\profile.ps1\\\"\"",
        "opacity": 25,
        "cursorShape": "bar",
        "cursorColor": "#FFFFFF",
        "backgroundImage": "{{HOME}}\\images\\inward-black-windows.png"
      },
      {
        "name": "Command Prompt",
        "guid": "{0caa0dad-35be-5f56-a8ff-afceeeaa6101}",
        "commandline": "cmd.exe",
        "opacity": 10,
        "backgroundImage": "{{HOME}}\\images\\cmdicon.jpg"
      },
      {
        "name": "Azure Cloud Shell",
        "guid": "{b453ae62-4e3d-5e58-b989-0a998ec441b8}",
        "source": "Windows.Terminal.Azure",
        "opacity": 10,
        "backgroundImage": "{{HOME}}\\images\\dragon.png"
      }
    ]
  },

  "schemes": [
    {
      "name": "One",
      "foreground": "#ffffff",
      "background": "#000000",
      "black": "#000000",
      "red": "#f50014",
      "green": "#64c022",
      "yellow": "#f8b12d",
      "blue": "#61AFEF",
      "purple": "#C678DD",
      "cyan": "#56B6C2",
      "white": "#DCDFE4",
      "brightBlack": "#5A6374",
      "brightRed": "#E06C75",
      "brightGreen": "#98C379",
      "brightYellow": "#ffa600",
      "brightBlue": "#61AFEF",
      "brightPurple": "#C678DD",
      "brightCyan": "#56B6C2",
      "brightWhite": "#ffffff"
    }
  ],

  "actions": [
    { "command": { "action": "copy", "singleLine": false }, "keys": "ctrl+c" },
    { "command": "paste", "keys": "ctrl+v" },
    { "command": "find", "keys": "ctrl+shift+f" },
    { "command": { "action": "splitPane", "split": "auto", "splitMode": "duplicate" }, "keys": "alt+shift+d" }
  ]
}
